{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApplyPilot AI",
  "version": "0.1.0",
  "identifier": "ai.applypilot.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/.next"
  },
  "app": {
    "windows": [
      {
        "title": "ApplyPilot AI — Career Operations",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3000 http://127.0.0.1:8002; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
