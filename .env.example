# Application
APP_NAME=ApplyPilot
ENVIRONMENT=development
TIMEZONE=Asia/Kolkata

# Database & Ports (5434/6381/8002 defaults avoid colliding with other local stacks)
POSTGRES_PORT=5434
REDIS_PORT=6381
BACKEND_PORT=8002
DATABASE_URL=postgresql+psycopg://applypilot:applypilot@localhost:5434/applypilot
REDIS_URL=redis://localhost:6381/0

# LLM Providers (keep real keys out of source control)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Search Integration
SEARCH_API_KEY=

# Gmail OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Security
SECRET_KEY=change-me-in-development-minimum-32-bytes-key
ENCRYPTION_KEY=change-me-fernet-or-aes-key
ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_PREVIOUS_KEYS=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage
STORAGE_DIR=../storage
MAX_RESUME_SIZE_BYTES=5242880

# Application Limits
DAILY_APPLICATION_TARGET=15
MAX_APPLICATIONS_PER_DAY=15
MIN_JOB_MATCH_SCORE=75

# Resume Auto-Tailoring Controls
AUTO_TAILOR_ENABLED=true
AUTO_TAILOR_DAILY_LIMIT=5
AUTO_TAILOR_MIN_SCORE=75

# Automation Policy
AUTO_SUBMIT_SUPPORTED_APIS=true
BROWSER_SUBMISSION_REQUIRES_APPROVAL=true
PAUSE_ALL_SUBMISSIONS=false
APPROVAL_TTL_HOURS=24
APPLICATION_ARTIFACT_RETENTION_DAYS=14
BROWSER_EXECUTION_TIMEOUT_SECONDS=60
BROWSER_HANDOFF_TTL_SECONDS=1800
CAPTURE_APPLICATION_ARTIFACTS=false
REQUIRE_OS_EGRESS_FIREWALL=false
OS_EGRESS_FIREWALL_RULE_PREFIX=ApplyPilot-Browser-Egress
